# Centralized Logging Configuration
# Auto-generated by RAICB - Responsible AI Compliance Blueprint

version: 1
disable_existing_loggers: false

# Log format templates
formatters:
  json:
    class: pythonjsonlogger.jsonlogger.JsonFormatter
    format: "%(timestamp)s %(level)s %(name)s %(message)s"

  detailed:
    format: "[%(asctime)s] %(levelname)-8s %(name)s:%(lineno)d - %(message)s"
    datefmt: "%Y-%m-%d %H:%M:%S"

  simple:
    format: "%(levelname)s - %(message)s"

# Log handlers
handlers:
  # Console output for local development
  console:
    class: logging.StreamHandler
    level: INFO
    formatter: simple
    stream: ext://sys.stdout

  # File output for all logs
  file_all:
    class: logging.handlers.RotatingFileHandler
    level: DEBUG
    formatter: detailed
    filename: logs/app.log
    maxBytes: 10485760  # 10MB
    backupCount: 10
    encoding: utf8

  # Separate file for errors
  file_errors:
    class: logging.handlers.RotatingFileHandler
    level: ERROR
    formatter: detailed
    filename: logs/errors.log
    maxBytes: 10485760  # 10MB
    backupCount: 10
    encoding: utf8

  # JSON structured logging for SIEM integration
  file_json:
    class: logging.handlers.RotatingFileHandler
    level: INFO
    formatter: json
    filename: logs/app.json
    maxBytes: 10485760  # 10MB
    backupCount: 20
    encoding: utf8

  # Audit trail logging (append-only, high retention)
  audit:
    class: logging.handlers.RotatingFileHandler
    level: INFO
    formatter: json
    filename: logs/audit.log
    maxBytes: 52428800  # 50MB
    backupCount: 100  # Keep 100 files (5GB total)
    encoding: utf8

# Logger configuration
loggers:
  # Application root logger
  {{ project_name | default('app') }}:
    level: DEBUG
    handlers: [console, file_all, file_errors, file_json]
    propagate: false

  # Authentication and authorization events
  {{ project_name | default('app') }}.auth:
    level: INFO
    handlers: [audit]
    propagate: false

  # Model inference logging
  {{ project_name | default('app') }}.inference:
    level: INFO
    handlers: [audit, file_json]
    propagate: false

  # Security events
  {{ project_name | default('app') }}.security:
    level: WARNING
    handlers: [audit, file_errors]
    propagate: false

  # Data access logging
  {{ project_name | default('app') }}.data:
    level: INFO
    handlers: [audit]
    propagate: false

  # Configuration changes
  {{ project_name | default('app') }}.config:
    level: INFO
    handlers: [audit]
    propagate: false

# Root logger
root:
  level: INFO
  handlers: [console, file_all]

---
# Critical Events to Log (ISO/IEC 42001 Compliance)

# 1. Authentication Events
#    - Login attempts (success/failure)
#    - Logout events
#    - Session creation/termination
#    - Password changes
#    - Multi-factor authentication events

# 2. Authorization Events
#    - Access granted/denied
#    - Permission changes
#    - Role assignments
#    - Privilege escalation attempts

# 3. Data Access Events
#    - Data read operations
#    - Data write operations
#    - Data deletion
#    - Bulk data exports
#    - PII/sensitive data access

# 4. Model Inference Events
#    - Prediction requests
#    - Model input (hash)
#    - Model output
#    - Confidence scores
#    - Model version used
#    - User ID and timestamp

# 5. Configuration Changes
#    - Config file modifications
#    - Environment variable changes
#    - Feature flag updates
#    - Model parameter changes

# 6. Security Events
#    - Rate limit violations
#    - Input validation failures
#    - Suspicious activity detection
#    - Blocked requests
#    - Attack attempts (injection, XSS, etc.)

