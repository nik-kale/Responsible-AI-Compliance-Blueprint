# Filebeat Configuration for SIEM Integration
# Auto-generated by RAICB - Responsible AI Compliance Blueprint
# Sends logs to Elasticsearch/Logstash for centralized monitoring

filebeat.inputs:
  # Application logs
  - type: log
    enabled: true
    paths:
      - /var/log/{{ project_name | default('app') }}/app.log
      - /var/log/{{ project_name | default('app') }}/errors.log
    fields:
      log_type: application
      environment: {{ environment | default('production') }}
      project: {{ project_name | default('app') }}
    fields_under_root: true
    multiline.pattern: '^\['
    multiline.negate: true
    multiline.match: after

  # Audit trail logs
  - type: log
    enabled: true
    paths:
      - /var/log/{{ project_name | default('app') }}/audit.log
    fields:
      log_type: audit
      environment: {{ environment | default('production') }}
      project: {{ project_name | default('app') }}
    fields_under_root: true
    json.keys_under_root: true
    json.add_error_key: true

  # Security events
  - type: log
    enabled: true
    paths:
      - /var/log/{{ project_name | default('app') }}/security.log
    fields:
      log_type: security
      environment: {{ environment | default('production') }}
      project: {{ project_name | default('app') }}
      priority: high
    fields_under_root: true
    json.keys_under_root: true

  # Model inference logs
  - type: log
    enabled: true
    paths:
      - /var/log/{{ project_name | default('app') }}/inference.log
    fields:
      log_type: inference
      environment: {{ environment | default('production') }}
      project: {{ project_name | default('app') }}
    fields_under_root: true
    json.keys_under_root: true

# Filebeat modules
filebeat.config.modules:
  path: ${path.config}/modules.d/*.yml
  reload.enabled: true

# Processors for log enrichment
processors:
  - add_host_metadata:
      when.not.contains.tags: forwarded
  - add_cloud_metadata: ~
  - add_docker_metadata: ~
  - add_kubernetes_metadata: ~

# Output configuration

# Option 1: Elasticsearch (direct)
output.elasticsearch:
  enabled: true
  hosts: ["{{ elasticsearch_host | default('localhost:9200') }}"]
  protocol: "https"
  username: "{{ elasticsearch_username | default('elastic') }}"
  password: "${ELASTICSEARCH_PASSWORD}"
  index: "{{ project_name | default('app') }}-%{[agent.version]}-%{+yyyy.MM.dd}"

  # Index lifecycle management
  ilm.enabled: true
  ilm.rollover_alias: "{{ project_name | default('app') }}"
  ilm.pattern: "{now/d}-000001"

# Option 2: Logstash (for additional processing)
# output.logstash:
#   enabled: false
#   hosts: ["{{ logstash_host | default('localhost:5044') }}"]
#   ssl.certificate_authorities: ["/etc/pki/root/ca.pem"]
#   ssl.certificate: "/etc/pki/client/cert.pem"
#   ssl.key: "/etc/pki/client/cert.key"

# Monitoring
monitoring.enabled: true
monitoring.elasticsearch:
  hosts: ["{{ elasticsearch_host | default('localhost:9200') }}"]
  username: "{{ elasticsearch_username | default('elastic') }}"
  password: "${ELASTICSEARCH_PASSWORD}"

# Logging
logging.level: info
logging.to_files: true
logging.files:
  path: /var/log/filebeat
  name: filebeat
  keepfiles: 7
  permissions: 0640

# Setup
setup.template.settings:
  index.number_of_shards: 1
  index.number_of_replicas: 1

setup.kibana:
  host: "{{ kibana_host | default('localhost:5601') }}"
  username: "{{ elasticsearch_username | default('elastic') }}"
  password: "${ELASTICSEARCH_PASSWORD}"

# Dashboards
setup.dashboards.enabled: true

---
# Installation Instructions:

# 1. Install Filebeat:
#    curl -L -O https://artifacts.elastic.co/downloads/beats/filebeat/filebeat-8.x.x-linux-x86_64.tar.gz
#    tar xzvf filebeat-8.x.x-linux-x86_64.tar.gz

# 2. Update this configuration with your Elasticsearch credentials:
#    export ELASTICSEARCH_PASSWORD='your-password'

# 3. Start Filebeat:
#    sudo ./filebeat -e -c filebeat.yml

# 4. Verify logs are being sent:
#    Check Kibana dashboards at http://{{ kibana_host | default('localhost:5601') }}
